# Copy to .env and fill in. Never commit .env.

# LLM for reply drafts: "gemini" (Google credits), "anthropic" (Claude) or "mock" (offline, no key).
# Leave LLM_MODE empty to auto-pick: Gemini if its key is set, else Claude, else mock.
LLM_MODE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING=low
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Dataset
HF_DATASET=Tobi-Bueck/customer-support-tickets
HF_FILE=aa_dataset-tickets-multi-lang-5-2-50-version.csv

# Retrieval
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=5

# Gate thresholds (overridden by models/thresholds.json written by scripts/train.py)
CRITICAL_THRESHOLD=0.40
MIN_CONFIDENCE=0.55
MIN_SIMILARITY=0.50

# Server
PORT=8000


# Public demo limits per visitor / overall (0 = off)
RATE_LIMIT_PER_HOUR=30
GLOBAL_LIMIT_PER_HOUR=600
